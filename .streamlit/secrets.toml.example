# .streamlit/secrets.toml.example
# For Streamlit Community Cloud Deployment:
# Add this under App Settings -> Secrets in the Streamlit Community Cloud dashboard.
#
# If running an Ollama instance on a remote server, VPS, or tunnel (e.g., ngrok, Cloudflare Tunnel, or RunPod):
OLLAMA_HOST = "https://your-remote-ollama-host.example.com"

# Optional custom model override (defaults to llama3:8b)
# DEFAULT_MODEL = "llama3:8b"
